FROM eclipse-temurin:21-jdk AS build

WORKDIR /workspace

COPY gradlew settings.gradle build.gradle ./
COPY gradle gradle
COPY e2e-test-jwt-ext/build.gradle e2e-test-jwt-ext/build.gradle
COPY service-app service-app

RUN chmod +x gradlew \
    && ./gradlew :service-app:bootJar --no-daemon

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /workspace/service-app/build/libs/service-app-0.0.1-SNAPSHOT.jar app.jar

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
